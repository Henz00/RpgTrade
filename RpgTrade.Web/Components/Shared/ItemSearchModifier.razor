@using RpgTrade.Web.Models
@using System.Net.Http.Json

@*This come below is the list of selected modifiers*@
        @foreach (ItemModifierFilter modifier in Filters)
        {<ItemModifier Filter="modifier" OnRemoveModifier="RemoveSelectedModifier" />}

@if (@availableModifiers.Count > 0)
{
    <ul class="item-search-modifier-holder">
        @foreach (var modifier in availableModifiers)
        {
            <li class="item-search-modifier" 
                @onclick="() => SelectModifier(modifier)">
                 <span>+# @modifier.Name</span>
            </li>
        }
    </ul>
} else
{
    <p>Could not fetch modifiers</p>
}

@code {
    [Parameter] public required HttpClient Http { get; set; }
    [Parameter] public required List<ItemModifierFilter> Filters { get; set; }
    private List<ItemModifierFilter> availableModifiers = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            availableModifiers = await Http.GetFromJsonAsync<List<ItemModifierFilter>>("api/item_modifiers") ?? [];
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            availableModifiers = [];
        }
    }   

    private void SelectModifier(ItemModifierFilter modifier)
    {
        Filters.Add(modifier);
        availableModifiers.Remove(modifier);
    }

    private void RemoveSelectedModifier(ItemModifierFilter modifier)
    {
        availableModifiers.Add(modifier);
        availableModifiers.Sort((modifier_1, modifier_2) => modifier_1.Name.CompareTo(modifier_2.Name));
        Filters.Remove(modifier);
    }
}
